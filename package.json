    "sass-embedded": "^1.89.2",
    "stk-table-vue": "^0.8.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
