{
  "name": "mcp-ui",
  "version": "0.1.0",
  "description": "Lightweight Vue 3 UI components for weather data dashboards.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/mcp-ui.umd.cjs",
  "module": "./dist/mcp-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mcp-ui.js",
      "require": "./dist/mcp-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "vue-tsc": "^2.2.0"
  }
}
