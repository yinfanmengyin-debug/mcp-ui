{
  "name": "mcp-ui",
  "version": "0.1.0",
  "description": "Lightweight Vue 3 UI components for weather data dashboards.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/mcp-ui.umd.cjs",
  "module": "./dist/mcp-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mcp-ui.js",
      "require": "./dist/mcp-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@handsontable/vue3": "^14.5.0",
    "@texel/color": "^1.1.10",
    "@vueuse/core": "^11.0.1",
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.0",
    "element-plus": "2.8.0",
    "file-saver": "^2.0.5",
    "handsontable": "^14.6.0",
    "lodash-es": "^4.17.21",
    "stk-table-vue": "^0.8.1",
    "vue": "^3.3.0",
    "vue-router": "^4.3.2",
    "xlsx": ">=0.18.0",
    "zrender": "^5.6.0 || ^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.16.0",
    "@handsontable/vue3": "^14.5.0",
    "@texel/color": "^1.1.10",
    "@vueuse/core": "^11.0.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.0",
    "element-plus": "2.8.0",
    "file-saver": "^2.0.5",
